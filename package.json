{
  "name": "packing-list-mobile-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "web": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "find-unused": "knip",
    "prebuild": "node -e \"require('react-dom/client')\" && npm run typecheck && npm run lint && knip && npm run test:unit",
    "spaces:cleanup": "node scripts/cleanup-spaces.js",
    "spaces:migrate": "node scripts/migrate-to-spaces.js",
    "list:dev-servers": "lsof -i tcp -P -n | grep LISTEN | grep node | awk '{print $9}'",
    "list:dev-servers-port": "lsof -ti tcp:3000"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "^2.5.14",
    "@types/hoist-non-react-statics": "^3.3.7",
    "@types/lodash": "^4.17.23",
    "@types/prop-types": "^15.7.15",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3",
    "@vitejs/plugin-react": "^4.3.0",
    "firebase-admin": "^13.6.1",
    "knip": "^5.82.1",
    "typescript": "~5.9.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
