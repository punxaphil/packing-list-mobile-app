{
  "name": "packing-list-mobile-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "web": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "find-unused": "knip",
    "prebuild": "npm run typecheck && npm run lint && knip && npm run test:unit",
    "spaces:cleanup": "node scripts/cleanup-spaces.js",
    "spaces:migrate": "node scripts/migrate-to-spaces.js",
    "list:dev-servers": "lsof -i tcp -P -n | grep LISTEN | grep node | awk '{print $9}'",
    "list:dev-servers-port": "lsof -ti tcp:3000"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^7.19.2",
    "firebase": "^11.0.2",
    "i18next": "^26.2.0",
    "react": "19.3.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@biomejs/biome": "^2.5.14",
    "@types/hoist-non-react-statics": "^3.3.7",
    "@types/lodash": "^4.17.23",
    "@types/prop-types": "^15.7.15",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "@vitejs/plugin-react": "^4.3.0",
    "firebase-admin": "^13.6.1",
    "knip": "^5.82.1",
    "typescript": "~5.9.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
